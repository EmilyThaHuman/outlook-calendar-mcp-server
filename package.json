{
  "name": "outlook-calendar-mcp-server",
  "version": "1.0.0",
  "description": "Microsoft Outlook Calendar MCP Server with OAuth 2.0 authentication",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "wrangler dev",
    "build": "tsc",
    "build:worker": "tsc && wrangler deploy --dry-run",
    "start": "node dist/index.js",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "kv:create": "wrangler kv:namespace create SESSIONS",
    "kv:create:preview": "wrangler kv:namespace create SESSIONS --preview"
  },
  "keywords": [
    "mcp",
    "outlook",
    "calendar",
    "oauth",
    "microsoft-graph",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@azure/identity": "^4.0.0",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1",
    "isomorphic-fetch": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.10.2",
    "@types/isomorphic-fetch": "^0.0.39",
    "@cloudflare/workers-types": "^4.20241218.0",
    "wrangler": "^3.96.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2"
  }
}







